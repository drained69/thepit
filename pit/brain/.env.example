# Copy to brain/.env — NEVER commit the real file.
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
PIT_CONTRACT=pit.yourname.testnet

# Keeper: calls ONLY rebalance / process_queue / harvest. Use a
# function-call access key restricted to those methods (see README).
KEEPER_ACCOUNT_ID=keeper.yourname.testnet
KEEPER_PRIVATE_KEY=ed25519:FUNCTION_CALL_KEY_HERE

# Inference (OpenAI-compatible). NEAR AI Cloud by default.
NEAR_AI_BASE=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=

# Converts harvested NEAR into the brain's compute budget (USD).
NEAR_USD=3.00

# Optional: post to a Telegram channel/group and answer mentions there.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TICK_SECONDS=300
POST_EVERY_TICKS=12
