# Copy to pit/gate-agent/.env — NEVER commit the real file.
AGENT_CONTRACT_ID=pit-gate-agents.yourname.testnet
SPONSOR_ACCOUNT_ID=yourname.testnet
SPONSOR_PRIVATE_KEY=ed25519:FUNDS_THE_AGENT_ACCOUNT
SALE_ID=PIT-001
# shade (default; real TEE on Phala, or Shade local mode outside one) | dev-key (local tests)
GATE_IDENTITY=shade
# Shade local mode only: fixes the agent account between restarts (ignored in a TEE).
LOCAL_DERIVATION_SECRET=
