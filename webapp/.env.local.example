# Local web app configuration: copy to webapp/.env.local (git-ignored).
# Every VITE_* value is built into the public bundle: never put secrets here.

# Network: testnet (default) or mainnet.
VITE_NEAR_NETWORK=testnet

# The launchpad factory (or VITE_PIT_CONTRACT for a single coin).
# Leave both empty for preview mode with sample data.
VITE_PIT_FACTORY=pit.yourname.testnet
# VITE_PIT_CONTRACT=pit.yourname.testnet

# Services: the brain's feed API and the launch gate.
VITE_PIT_BRAIN_URL=http://localhost:3151
VITE_PIT_GATE_URL=http://localhost:3140

# Optional overrides.
# VITE_NEAR_RPC=https://rpc.testnet.fastnear.com
# VITE_NEAR_AI_BASE=https://cloud-api.near.ai/v1

# Server-only (set in the server process, never as VITE_*):
#   RHEA_API_KEY   enables cross-chain funding (mainnet)
#   TRUST_PROXY=1  behind Railway or another reverse proxy
