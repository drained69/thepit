# webapp dev config — copy to webapp/.env.local
VITE_SALE_CONTRACT=yourname.testnet          # the account deploy.mjs deployed to
VITE_GATE_URL=http://localhost:8788
# Pin the public root reported by `tee-gate /api/info` before building the UI.
# For the checked-in legacy/human/res/sim-root.pub, use its current hex contents below.
VITE_SIM_ROOT_PUBKEY=829f7a1c072d4491c72be6a3b812413c48ee049009bdbbbd60594e8ec9c7ca99

# The Pit page (pit.html)
VITE_PIT_CONTRACT=pit.yourname.testnet
VITE_PIT_GATE_URL=http://localhost:8788

# Cross-chain funding: export RHEA_API_KEY in the server process environment.
# Railway: set it on the web service. Never use a VITE_* name for this secret.
# Requires VITE_NEAR_NETWORK=mainnet and a reviewed mainnet Pit contract.
